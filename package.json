{
  "name": "@vbcdx/dsh-openrouter-credit-plugin",
  "version": "1.3.0",
  "description": "DSH plugin that displays the current OpenRouter credit usage in the conversation header",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    ".env.example",
    "README.md",
    "PLUGIN.md"
  ],
  "dsh": {
    "plugin": true,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "openrouter",
    "credit",
    "usage"
  ],
  "author": "VBCDX",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}
